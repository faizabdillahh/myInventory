# ==============================================================================
# Root .htaccess for Laragon & Apache Environments
# Redirects all incoming requests to the CodeIgniter 4 public/ directory
# ==============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
